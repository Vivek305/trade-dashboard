#!/bin/sh
# Blocks commits that contain likely Schwab/app secrets or committed .env files.
# Installed via: npm install (runs the "prepare" script, see package.json)

set -eu

staged_files=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$staged_files" ]; then
  exit 0
fi

blocked=0

for file in $staged_files; do
  case "$file" in
    .env|.env.local|.env.*.local|*.pem|*.key|*.crt)
      echo "pre-commit: refusing to commit secret/cert file: $file"
      blocked=1
      ;;
  esac
done

# Look for assignments to known secret-shaped keys with a non-placeholder value.
secret_pattern='(SCHWAB_CLIENT_SECRET|SCHWAB_TOKEN_ENCRYPTION_KEY|APP_PASSWORD_HASH|SESSION_SECRET|DATABASE_URL)[[:space:]]*[:=][[:space:]]*[^[:space:]"'"'"']{8,}'

for file in $staged_files; do
  # .env.example is expected to contain these key names with placeholder values only.
  [ "$file" = ".env.example" ] && continue
  [ -f "$file" ] || continue

  # Exclude lines whose value is a docker-compose/shell variable reference (${VAR}),
  # e.g. `DATABASE_URL: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@...` —
  # those are templates, not literal secrets.
  if git diff --cached -- "$file" \
    | grep -E '^\+' | grep -Ev '^\+\+\+' \
    | grep -Ev '\$\{[A-Za-z_][A-Za-z0-9_]*\}' \
    | grep -Eiq "$secret_pattern"; then
    echo "pre-commit: possible secret detected in $file (matches $secret_pattern)"
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  echo "pre-commit: commit blocked. Remove secrets/certs from the diff (use .env.local instead) or use 'git commit --no-verify' only if you are certain this is a false positive."
  exit 1
fi

exit 0
