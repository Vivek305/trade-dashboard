# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - NEVER commit real secrets.

# --- Schwab Developer Portal app credentials ---
SCHWAB_CLIENT_ID=your-schwab-client-id
SCHWAB_CLIENT_SECRET=your-schwab-client-secret
# Must exactly match the redirect URI registered in the Schwab Developer Portal.
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182

# 32-byte key, base64-encoded, used to encrypt Schwab tokens at rest.
# Generate with: openssl rand -base64 32
SCHWAB_TOKEN_ENCRYPTION_KEY=replace-with-generated-base64-key

# --- Local Postgres (docker-compose) ---
POSTGRES_USER=trading_journal
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_DB=trading_journal
# Host-side apps/scripts (e.g. schwab-auth, drizzle-kit) connect via localhost;
# the "web" container connects via the "postgres" service hostname instead.
DATABASE_URL=postgresql://trading_journal:replace-with-a-strong-local-password@localhost:5432/trading_journal

# --- App-wide password gate ---
# Hash of the single-user app password (e.g. scrypt/bcrypt), never plaintext.
APP_PASSWORD_HASH=replace-with-generated-password-hash
# Secret used to sign the session cookie.
SESSION_SECRET=replace-with-generated-random-secret
